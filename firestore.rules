rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // YUCA 앱 데이터: 로그인한 사용자만 읽기/쓰기
    match /yuca_data/{doc} {
      allow read, write: if request.auth != null;
    }
    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
